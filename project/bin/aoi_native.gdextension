[configuration]

entry_symbol = "aoi_native_library_init"
compatibility_minimum = "4.1"
reloadable = false

[libraries]

; Android
android.x86_64.single.debug = "./android/libaoi_native.android.template_debug.x86_64.so"
android.x86_64.single.release = "./android/libaoi_native.android.template_release.x86_64.so"
android.arm64.single.debug = "./android/libaoi_native.android.template_debug.arm64.so"
android.arm64.single.release = "./android/libaoi_native.android.template_release.arm64.so"
android.arm32.single.debug = "./android/libaoi_native.android.template_debug.arm32.so"
android.arm32.single.release = "./android/libaoi_native.android.template_release.arm32.so"

; Windows
windows.x86_64.single.debug = "./windows/aoi_native.windows.template_debug.x86_64.dll"
windows.x86_64.single.release = "./windows/aoi_native.windows.template_release.x86_64.dll" 
